NODE_ENV=development
PORT=4000
TZ=Africa/Porto-Novo

# Origines autorisees pour le front (separees par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alloprof
DB_TIMEZONE=+01:00
DB_LOGGING=false

# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL du front : sert a construire le lien d'invitation des profs (copie par l'admin)
FRONT_URL=http://localhost:3000

# Utilises par `npm run admin:create`
ADMIN_NOM=Admin
ADMIN_PRENOM=AlloProf
ADMIN_EMAIL=admin@alloprof.local
ADMIN_TELEPHONE=+22900000000
ADMIN_PASSWORD=
