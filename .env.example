NODE_ENV=development
PORT=4000
TZ=Africa/Porto-Novo

# Origines autorisees pour le front (separees par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alloprof
DB_TIMEZONE=+01:00
DB_LOGGING=false

# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL du front : sert a construire les liens d'invitation et de reset
FRONT_URL=http://localhost:3000

# SMTP (laisser SMTP_HOST vide en dev : les emails s'affichent dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AlloProf <no-reply@alloprof.local>"

# Utilises par `npm run admin:create`
ADMIN_NOM=Admin
ADMIN_PRENOM=AlloProf
ADMIN_EMAIL=admin@alloprof.local
ADMIN_TELEPHONE=+22900000000
ADMIN_PASSWORD=
