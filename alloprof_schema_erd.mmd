    bigint user_id PK
    string adresse
  }
  PROFESSEURS {
    bigint user_id PK
    text bio
    string niveaux_enseignes
    enum statut
  }
  VILLES {
    int id PK
    string nom UK
    bool est_active
  }
  SPECIALITES {
    int id PK
    string libelle UK
  }
  PROFESSEUR_SPECIALITES {
    bigint professeur_id PK
    int specialite_id PK
  }
  DEMANDES {
    bigint id PK
    bigint client_id FK
    int ville_id FK
    int specialite_id FK
